{
  "version": "6.0",
  "screens": [
    {
      "id": "SIMULACAO_SCREEN",
      "title": "Simulação de crédito",
      "terminal": true,
      "success": true,
      "data": {},
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextHeading",
            "text": "Reforço de Caixa Ticket"
          },
          {
            "type": "TextSubheading",
            "text": "Informe os valores abaixo para recalcularmos sua proposta de crédito personalizada:"
          },
          {
            "type": "TextInput",
            "name": "valor_simulacao",
            "label": "Valor desejado (R$)",
            "input-type": "number",
            "required": true,
            "helper-text": "Digite só números. Ex.: 40000"
          },
          {
            "type": "TextInput",
            "name": "quantidade_parcelas",
            "label": "Quantidade de parcelas",
            "input-type": "number",
            "required": true,
            "helper-text": "Digite a quantidade (de 6 a 24 parcelas)"
          },
          {
            "type": "Footer",
            "label": "Calcular Simulação",
            "on-click-action": {
              "name": "complete",
              "payload": {
                "valor_simulacao": "${form.valor_simulacao}",
                "quantidade_parcelas": "${form.quantidade_parcelas}"
              }
            }
          }
        ]
      }
    }
  ]
}
