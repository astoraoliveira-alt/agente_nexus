      "name": "Enviar texto",
      "retryOnFail": true,
      "credentials": {
        "evolutionApi": {
          "id": "68pjEsIpdOiMTDE5",
          "name": "Evolution account"
        }
      },
      "onError": "continueRegularOutput"
