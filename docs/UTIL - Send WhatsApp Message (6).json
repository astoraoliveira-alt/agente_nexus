    {
      "parameters": {
        "jsCode": "// 🔒 Validação mínima\nif (!$json.phone) {\n  throw new Error(\"❌ phone não informado\");\n}\n\nif (!$json.message && !$json.template_id) {\n  throw new Error(\"❌ message ou template_id não informado\");\n}\n\n// 🔄 Normalização\nconst phone = String($json.phone)\n  .replace('@c.us', '')\n  .replace(/\\D/g, '');\n\nconst provider = String($json.provider || 'evolution')\n  .toLowerCase()\n  .trim();\n\n// ✅ Providers suportados\nconst allowedProviders = ['evolution', 'meta', 'zenvia'];\n\nif (!allowedProviders.includes(provider)) {\n  throw new Error(`❌ provider inválido: ${provider}`);\n}\n\n// 🔐 Campos opcionais (Meta)\nconst meta_token = $json.meta_api_token || null;\nconst meta_phone_id = $json.meta_phone_number_id || null;\n\n// 🔐 Campos opcionais (Zenvia)\nconst zenvia_api_token = $json.zenvia_api_token || null;\nconst zenvia_channel_id = $json.zenvia_channel_id || null;\nconst template_id = $json.template_id || null;\nconst zenvia_image_url = $json.zenvia_image_url || null;\nconst cta_link = $json.cta_link || null;\n\n// 🔘 Botões Interativos\nconst interactive_buttons = $json.interactive_buttons || null;\n\n// Fallback visual para mensagem se houver botões e for texto normal (Ex: Evolution API)\nlet final_message = $json.message;\nif (interactive_buttons && interactive_buttons.tipo === 'botoes' && provider === 'evolution') {\n    final_message += '\\n\\nResponda com uma das opções:\\n👉 *' + interactive_buttons.opcoes.join('* ou *') + '*';\n}\n\nconst baseFields = {\n  phone,\n  provider,\n  meta_token,\n  meta_phone_id,\n  zenvia_api_token,\n  zenvia_channel_id,\n  template_id,\n  zenvia_image_url,\n  cta_link\n};\n\n// 🚀 Se houver pre_message e/ou media, desmembra em múltiplos envios sequenciais.\n// Ordem final: [1] texto introdutório -> [2] documento/mídia -> [3] pergunta + botões\nif (interactive_buttons && (interactive_buttons.pre_message || interactive_buttons.media)) {\n  const items = [];\n\n  // Mensagem 1: texto introdutório (se houver)\n  if (interactive_buttons.pre_message) {\n    items.push({\n      json: {\n        ...$json,\n        ...baseFields,\n        message: interactive_buttons.pre_message,\n        interactive_buttons: null\n      }\n    });\n  }\n\n  // Mensagem 2: documento/mídia (se houver)\n  // Fallback de texto (usado só pelo provider Evolution, que ainda não anexa arquivo aqui):\n  // como a \"legenda\" foi removida do media (V21), cai no texto fixo abaixo em vez de string vazia.\n  if (interactive_buttons.media) {\n    items.push({\n      json: {\n        ...$json,\n        ...baseFields,\n        message: interactive_buttons.media.legenda || '📄 Termo de Autorização',\n        interactive_buttons: {\n          tipo: 'documento',\n          media: interactive_buttons.media\n        }\n      }\n    });\n  }\n\n  // Mensagem 3: pergunta final (com botões, se houver)\n  items.push({\n    json: {\n      ...$json,\n      ...baseFields,\n      message: final_message,\n      interactive_buttons: (interactive_buttons.opcoes)\n        ? { ...interactive_buttons, pre_message: null, media: null }\n        : null\n    }\n  });\n\n  return items;\n}\n\n// 🚀 Retorno padronizado (para todos os demais fluxos sem pre_message/media)\nreturn [\n  {\n    json: {\n      ...$json,\n      ...baseFields,\n      message: final_message,\n      interactive_buttons\n    }\n  }\n];"
      },
