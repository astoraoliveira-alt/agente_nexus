    {
      "parameters": {
        "method": "POST",
        "url": "=https://api.zenvia.com/v2/channels/whatsapp/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{$json.zenvia_api_token}}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "X-API-TOKEN",
              "value": "={{$json.zenvia_api_token}}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{\nJSON.stringify({\n  \"from\": $json.zenvia_channel_id || \"551151183815\",\n  \"to\": $json.phone,\n  \"contents\": [\n    // 1. Prioridade: Se tiver media_url vindo do operador/chat humano (Anexo/Contrato)\n    $json.media_url ? {\n      \"type\": \"file\",\n      \"fileUrl\": $json.media_url,\n      \"fileMimeType\": $json.media_type || \"application/pdf\",\n      \"fileName\": $json.file_name || \"contrato.pdf\",\n      ...($json.message ? { \"fileCaption\": $json.message } : {})\n    } :\n    // 2. Se tiver template\n    $json.template_id ? {\n      \"type\": \"template\",\n      \"templateId\": $json.template_id,\n      \"fields\": {\n        \"nome\": $json.contact_name || \"Cliente\",\n        \"variavellink\": $json.cta_link\n          ? (($json.cta_link.match(/[?&]t=([^&]+)/) || [])[1] || \"\")\n          : \"\",\n        ...($json.zenvia_image_url ? { \"imageUrl\": $json.zenvia_image_url } : {})\n      }\n    } :\n    // 3. Se for documento vindo de botões interativos\n    ($json.interactive_buttons && $json.interactive_buttons.tipo === 'documento') ? {\n      \"type\": \"file\",\n      \"fileUrl\": $json.interactive_buttons.media.url,\n      \"fileMimeType\": $json.interactive_buttons.media.mimetype || \"application/pdf\",\n      \"fileName\": $json.interactive_buttons.media.nome_arquivo || \"documento.pdf\",\n      ...($json.interactive_buttons.media.legenda ? { \"fileCaption\": $json.interactive_buttons.media.legenda } : {})\n    } :\n    // 4. Se forem botões interativos\n    ($json.interactive_buttons && $json.interactive_buttons.tipo === 'botoes') ? {\n      \"type\": \"button\",\n      \"body\": $json.message,\n      \"buttons\": $json.interactive_buttons.opcoes.map((opt, i) => ({\n        \"type\": \"reply\",\n        \"id\": i === 0 ? \"optin_sim\" : \"optin_nao\",\n        \"title\": opt\n      }))\n    } :\n    // 5. Caso contrário, mensagem de texto normal\n    {\n      \"type\": \"text\",\n      \"text\": $json.message\n    }\n  ]\n})\n}}\n",
        "options": {
          "batching": {
            "batch": {
              "batchSize": 1,
              "batchInterval": 2000
            }
          }
        }
      },
